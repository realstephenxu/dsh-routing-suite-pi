{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/pi-memory-recall-policy.schema.json",
  "title": "Pi Memory Recall Policy",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean", "default": true },
    "topK": { "type": "integer", "minimum": 0, "default": 3 },
    "minScore": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.25 },
    "maxChars": { "type": "integer", "minimum": 0, "default": 2000 }
  },
  "additionalProperties": false
}
